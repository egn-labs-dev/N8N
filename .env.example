# Required API Keys
# Copy this file to .env and fill in your actual keys

# Firecrawl API Key (get it at https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-api-key-here

# OpenAI API Key (get it at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-api-key-here

# Telegram Bot Token (get it from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Google Sheets Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit)
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# OpenAI Model (recommended: gpt-4o for best quality, gpt-4o-mini for speed/cost)
OPENAI_MODEL=gpt-4o
